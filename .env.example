# ---------------------------------------------------------------------------
# CaseBrief configuration. Copy to `.env` and edit. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Demo mode: when true the app runs end-to-end with NO LLM/embedding API key.
# Generation is served from curated per-case fixtures; retrieval, claim
# validation, contradiction detection and metrics still execute for real.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset for the zero-setup SQLite demo database (~/.missiontrust/missiontrust.db).
# For the full PostgreSQL + pgvector stack (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://missiontrust:missiontrust@localhost:5433/missiontrust
# DATABASE_URL=

# ---------------------------------------------------------------------------
# LLM provider: demo | anthropic | openai | groq
# ---------------------------------------------------------------------------
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint (vLLM, Azure gateway, LiteLLM, ...)
OPENAI_BASE_URL=
# Groq — OpenAI-compatible, so it reuses the same client. Check Groq's current
# model list before pinning: available model IDs change fairly often.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4000

# ---------------------------------------------------------------------------
# Embeddings: local | openai
#   local  -> deterministic hashed character/word n-gram embedder, no API key
#   openai -> OPENAI_API_KEY + EMBEDDING_MODEL
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512

# ---------------------------------------------------------------------------
# Retrieval / chunking
# ---------------------------------------------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=16
EVIDENCE_TOP_K=4

# ---------------------------------------------------------------------------
# Assurance scoring weights + thresholds (prototype heuristic, see README)
# ---------------------------------------------------------------------------
WEIGHT_SEMANTIC=0.40
WEIGHT_RETRIEVAL=0.20
WEIGHT_ENTAILMENT=0.40
THRESHOLD_SUPPORTED=0.75
THRESHOLD_WEAK=0.55
# Cosine calibration band (raw cosine is rescaled onto 0..1 across this range)
SEMANTIC_FLOOR=0.08
SEMANTIC_CEILING=0.45

# ---------------------------------------------------------------------------
# Reviewer identity (placeholder for real IAM / SSO in production)
# ---------------------------------------------------------------------------
REVIEWER_NAME=Demo Reviewer
REVIEWER_ROLE=Adjudication Analyst
